<?php

/**
 * Implements hook_schema().
 */
function ai_log_analysis_schema() {
  $schema['custom_log'] = [
    'description' => 'Stores custom log messages.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'message' => [
        'type' => 'text',
        'not null' => TRUE,
      ],
      'severity' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'link' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'location' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'referer' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'hostname' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'timestamp' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'type' => ['type'],
      'timestamp' => ['timestamp'],
    ],
  ];

  return $schema;
}
