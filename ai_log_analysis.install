<?php

/**
 * @file
 * Install, update, and uninstall functions for the ai_log_analysis module.
 */

/**
 * Implements hook_schema().
 */
function ai_log_analysis_schema() {
  $schema['custom_log'] = [
    'description' => 'Stores custom log messages.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'message' => [
        'type' => 'text',
        'not null' => TRUE,
      ],
      'severity' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'link' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'location' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'referer' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'hostname' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'timestamp' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'variables' => [
        'type' => 'blob',
        'not null' => FALSE,
        'description' => 'Serialized variables (if any) for the log message.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'type' => ['type'],
      'timestamp' => ['timestamp'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_uninstall().
 */
function ai_log_analysis_uninstall() {
  // Drop the custom log table on uninstall.
  \Drupal::database()->schema()->dropTable('custom_log');

  // Delete configuration for this module.
  \Drupal::configFactory()->getEditable('ai_log_analysis.settings')->delete();
}

/**
 * Implements hook_update_N().
 *
 * Add a "variables" column (blob) to the custom_log table if it does not exist.
 */
function ai_log_analysis_update_8001() {
  $connection = \Drupal::database();
  $schema = $connection->schema();
  if ($schema->tableExists('custom_log') && !$schema->fieldExists('custom_log', 'variables')) {
    $schema->addField('custom_log', 'variables', [
      'type' => 'blob',
      'not null' => FALSE,
      'description' => 'Serialized variables (if any) for the log message.',
    ]);
  }
}
